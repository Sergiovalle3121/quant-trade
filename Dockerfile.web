# Backtest audit web service. Research-only: no broker, no keys, no execution.
# Free mode unless every Stripe variable is present in the environment.
FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN useradd --create-home --shell /usr/sbin/nologin quant
# Pango lays out the report PDF (WeasyPrint); DejaVu covers glyphs the site fonts lack.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libpango-1.0-0 libpangoft2-1.0-0 \
       libharfbuzz-subset0 fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml README.md requirements.lock.txt ./
COPY src ./src
COPY configs ./configs
RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir -e ".[cloud,web]" -c requirements.lock.txt \
    && mkdir -p /app/state/audit && chown -R quant:quant /app/state
USER quant
EXPOSE 8000
# exec: the server itself gets Railway's SIGTERM and finishes the audits and
# PDFs in flight (railway.json drainingSeconds) instead of a shell ignoring it.
CMD ["sh", "-c", "exec quant-trade audit serve --host 0.0.0.0 --port ${PORT:-8000}"]
