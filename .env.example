POLYGON_API_KEY=
DATA_CACHE_DIR=data/cache
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET_KEY=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

# Backtest audit web service (never commit real values; Railway holds them).
DATABASE_URL=
AUDIT_BASE_URL=
AUDIT_FREE_MODE=true
AUDIT_MAX_UPLOAD_BYTES=5000000
AUDIT_MAX_UPLOADS_PER_HOUR_PER_IP=10
AUDIT_PRICE_USD_CENTS=2900
AUDIT_PACK_PRICE_USD_CENTS=6900
AUDIT_RETENTION_DAYS=30
# true: the service deletes expired unpaid uploads itself (at start, then
# daily). Setting it is the explicit confirmation of that retention delete.
AUDIT_AUTO_PURGE=false
AUDIT_BOOTSTRAP_SAMPLES=1000
# 0 locally; 1 on Railway (one reverse proxy in front of the service).
AUDIT_TRUSTED_PROXY_HOPS=0
# Audits computed at once, and how long another upload waits for a slot
# before it is told the service is busy.
AUDIT_MAX_CONCURRENT_AUDITS=2
AUDIT_QUEUE_SECONDS=30
# Sell with access codes (bank transfer, Mercado Pago, WhatsApp). Together
# with AUDIT_FREE_MODE=false this turns on paid mode without Stripe.
AUDIT_ACCESS_CODES=false
# Disable new invite rewards during an incident without invalidating earned credits.
AUDIT_REFERRAL_REWARDS=true
# Service-wide cap on rewarded invites per UTC month (one credit per invite).
AUDIT_REFERRAL_GLOBAL_MONTHLY_CAP=100
# Migration default is false. Public paid launch requires true plus working
# HTTPS and e-mail delivery (Resend or SMTP, below), a stable 32+ character
# token secret across every replica, and confirmation of legacy accounts
# before they may buy or earn invite credits.
AUDIT_EMAIL_VERIFICATION_REQUIRED=false
AUDIT_EMAIL_TOKEN_SECRET=
AUDIT_SMTP_HOST=
AUDIT_SMTP_PORT=587
AUDIT_SMTP_USERNAME=
AUDIT_SMTP_PASSWORD=
AUDIT_SMTP_FROM=
AUDIT_SMTP_SECURITY=starttls
# Resend's HTTPS API: the transport used instead of SMTP when the key (re_...)
# is set. Railway blocks outbound SMTP below the Pro plan. AUDIT_EMAIL_FROM
# (it wins over AUDIT_SMTP_FROM) must be an address on a domain verified in
# Resend. With AUDIT_EMAIL_TOKEN_SECRET empty the token secret is derived
# from this key.
AUDIT_RESEND_API_KEY=
AUDIT_EMAIL_FROM=
# Where a client asks for a code: an https:// link (e.g. WhatsApp) or mailto:.
AUDIT_CONTACT_URL=
# Operator details for /terminos and /privacidad (no defaults: the pages show
# "[sin configurar]" until they are set). Have a lawyer review both texts
# before charging.
AUDIT_OPERATOR_NAME=
AUDIT_OPERATOR_CONTACT=
AUDIT_OPERATOR_ADDRESS=
AUDIT_JURISDICTION=
# Optional: the same two values as the English and Portuguese pages print
# them. Empty shows the value above as written. No defaults.
AUDIT_OPERATOR_ADDRESS_EN=
AUDIT_OPERATOR_ADDRESS_PT=
AUDIT_JURISDICTION_EN=
AUDIT_JURISDICTION_PT=
# Owner panel at /panel to create access codes from a browser. Off unless set
# to a random secret of at least 32 characters (python -c "import secrets;
# print(secrets.token_urlsafe(32))"). No default.
AUDIT_ADMIN_KEY=
# Optional: serve the owner panel at another path (default /panel). Starts
# with /, 2-64 characters from A-Z a-z 0-9 / _ -, no //, no trailing slash, and
# not under a public route (/cuenta, /pt, /audits...). An invalid value keeps
# /panel. It is never listed in robots.txt or the sitemap.
AUDIT_PANEL_PATH=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Live Checkout stays closed when empty. List only countries approved for the
# actual offer, provider account and local terms, e.g. MX. Buyer declares a
# billing country before Checkout; Stripe billing country is checked after payment.
AUDIT_APPROVED_MARKETS=
# Historical Stripe Payment Links are disabled for new sales by default.
# Keep old webhooks enabled; disable old links in Stripe before live charges.
AUDIT_LEGACY_PAYMENT_LINKS_ENABLED=false
