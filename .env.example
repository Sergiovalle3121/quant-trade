POLYGON_API_KEY=
DATA_CACHE_DIR=data/cache
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET_KEY=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

# Backtest audit web service (never commit real values; Railway holds them).
DATABASE_URL=
AUDIT_BASE_URL=
AUDIT_FREE_MODE=true
AUDIT_MAX_UPLOAD_BYTES=5000000
AUDIT_MAX_UPLOADS_PER_HOUR_PER_IP=10
AUDIT_PRICE_USD_CENTS=4900
AUDIT_RETENTION_DAYS=30
AUDIT_BOOTSTRAP_SAMPLES=1000
# 0 locally; 1 on Railway (one reverse proxy in front of the service).
AUDIT_TRUSTED_PROXY_HOPS=0
# Sell with access codes (bank transfer, Mercado Pago, WhatsApp). Together
# with AUDIT_FREE_MODE=false this turns on paid mode without Stripe.
AUDIT_ACCESS_CODES=false
# Where a client asks for a code: an https:// link (e.g. WhatsApp) or mailto:.
AUDIT_CONTACT_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
